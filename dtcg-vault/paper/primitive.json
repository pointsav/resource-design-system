          "$value": "8.5in",
          "$description": "US Letter width — shared by every Paper CSS-print document",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-paper-primitive-page-size-letter-width",
              "pillar": "paper",
              "layer": "primitive",
              "family": "page",
              "schemaVersion": 1
            }
          }
        },
        "size-letter-height": {
